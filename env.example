# 环境配置
ENV=dev  # dev 或 prod

# Etherscan V2 API 密钥配置
# 方式1: 单个API密钥 (从 https://etherscan.io/apis 获取)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# 方式2: 多个API密钥 (用逗号分隔，推荐用于避免API限制)
# ETHERSCAN_API_KEYS=key1,key2,key3

# 链配置
# 支持的链:
# - 1: Ethereum Mainnet (以太坊主网)
# - 56: BNB Smart Chain Mainnet (币安智能链)
# - 8453: Base Mainnet (Base链)
# 默认使用 Ethereum Mainnet
CHAIN_ID=1

# Webhook URL (钉钉机器人或企业微信机器人)
WEBHOOK_URL=https://your-webhook-url-here

# 代理设置 (可选)
USE_PROXY=false
PROXY_URL=

# 监听的地址列表
# 方式1: JSON 数组格式 (推荐)
MONITOR_ADDRESSES=["0x1234567890abcdef", "0xabcdef1234567890", "0x9876543210fedcba"]

# 方式2: 逗号分隔格式 (兼容)
# MONITOR_ADDRESSES=0x1234567890abcdef,0xabcdef1234567890,0x9876543210fedcba

# 新代币数量阈值 (默认 1M = 1000000)
# 当检测到新代币数量超过此阈值时发送告警
NEW_TOKEN_AMOUNT_THRESHOLD=1000000

# 检查间隔 (秒，默认 600 = 10分钟)
CHECK_INTERVAL=600

# 时间窗口 (分钟，默认 10 = 10分钟)
# 只检查最近N分钟内的代币交易，而不是所有历史交易
TIME_WINDOW_MINUTES=10

# API限制控制配置
# 最小请求间隔（秒，默认 0.5）
MIN_REQUEST_INTERVAL=0.5

# 遇到限制时的重试延迟（秒，默认 5）
RATE_LIMIT_RETRY_DELAY=5

# 最大重试次数（默认 3）
MAX_RETRIES=3

# Twitter API 配置
# API 基础URL
TWITTER_API_BASE_URL=http://127.0.0.1:8008
# 发送推文的端点
TWITTER_TWEET_ENDPOINT=/tweet
# 搜索推文的端点
TWITTER_SEARCH_ENDPOINT=/search/user_tweets
# 要搜索的用户名
TWITTER_USERNAME=binance
# 推文发送开关 (默认启用)
TWITTER_ENABLED=true

# 多链配置说明:
# 1. 单链模式: 设置 CHAIN_ID 为特定链ID (1, 56, 或 8453)
# 2. 多链模式: 在 config.py 中启用多个链的 enabled=True
#    当前默认启用所有三个链:
#    - Ethereum Mainnet (Chain ID: 1)
#    - BNB Smart Chain Mainnet (Chain ID: 56) 
#    - Base Mainnet (Chain ID: 8453)
#
# 多链模式会自动为每个链创建独立的代币记录文件:
# - token_records_chain_1.json (Ethereum)
# - token_records_chain_56.json (BSC)
# - token_records_chain_8453.json (Base) 